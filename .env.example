DATABASE_URL=sqlite:///.data/trilingo.db
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
HOST=127.0.0.1
PORT=8000
QA_MODE=false

# Local-only operation: Trilingo uses zero external or local AI, STT, or runtime TTS providers.
# Models, containers, and voice packs are never downloaded.

# Versioned authored MP3 pack. Set AUDIO_PACK_ENABLED=false to force text-alternative
# fallback (HTTP 503 audio_unavailable) or to isolate a test from the bundled files.
AUDIO_PACK_DIR=content/audio
AUDIO_PACK_ENABLED=true
