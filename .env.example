DATABASE_URL=sqlite:///.data/trilingo.db
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
AI_ENABLED=false
STT_ENABLED=false
HOST=127.0.0.1
PORT=8000
QA_MODE=false

# Provider calls require both these server gates and per-provider enablement in Profile.
# Only configured loopback AI (LM Studio/OpenAI-compatible) and STT (Whisper-compatible)
# services are contacted; runtime TTS is removed and models/containers are never downloaded.

# Versioned authored MP3 pack. Set AUDIO_PACK_ENABLED=false to force text-alternative
# fallback (HTTP 503 audio_unavailable) or to isolate a test from the bundled files.
# Zero runtime TTS fallback or audio cache directory exists.
AUDIO_PACK_DIR=content/audio
AUDIO_PACK_ENABLED=true
