# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure JSON assets, code and manifests preserve exact LF line endings
*.json text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
*.in text eol=lf
*.ini text eol=lf
*.mako text eol=lf
